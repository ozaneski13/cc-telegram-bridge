# Copy this file to .env and fill in the values. NEVER commit .env.

# Bot token from @BotFather (e.g. 123456789:AAH...)
BOT_TOKEN=

# Your numeric Telegram user id (DM @userinfobot to get it).
# Only messages from this id are accepted; everything else is silently dropped.
TELEGRAM_OWNER_ID=

# Shared secret between the hook forwarder and the daemon (any random hex).
# Generate one: python -c "import secrets; print(secrets.token_hex(16))"
BRIDGE_SECRET=

# Local HTTP port the daemon listens on (127.0.0.1 only).
PORT=8765

# Live mode: after you message from Telegram, each session's turn-end hook
# waits up to this many seconds for your next reply and injects it directly.
# Typing anything locally releases all waits instantly.
HOLD_SECONDS=600

# Grace period: when you are (possibly) at the PC, notifications wait this many
# seconds before going to Telegram; any prompt you type in the app cancels all
# pending ones. Skipped entirely in live mode (phone replies arrive instantly).
# Set 0 for near-immediate notifications.
NOTIFY_GRACE_SECONDS=180

# Multiple-choice questions: when you are on the phone (live mode), the question
# is sent with inline buttons and the session waits this long for your tap.
# At the PC nothing waits — the question opens in the app as usual.
ASK_WAIT_SECONDS=300

# How a tapped answer is fed back: "input" pre-fills the tool's answers,
# "deny" returns the answer as feedback text instead. Switch to deny if
# questions still open in the app after you tap.
ASK_ANSWER_MODE=input

# Comma-separated cwd substrings whose sessions should NOT notify.
IGNORE_CWD_SUBSTRINGS=cc-telegram-bridge
