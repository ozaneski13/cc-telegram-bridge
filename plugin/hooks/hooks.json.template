{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify_event.py"],
            "timeout": 900
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify_event.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify_event.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify_event.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/notify_event.py"],
            "timeout": 400
          }
        ]
      }
    ]
  }
}
